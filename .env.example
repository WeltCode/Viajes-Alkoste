# Instagram feed (optional). Leave unset to use the curated placeholder feed.
# Point this to a serverless proxy or a third-party feed service that returns
# Instagram media JSON (see src/lib/instagram.js for details).
VITE_INSTAGRAM_ENDPOINT=
VITE_INSTAGRAM_PROFILE=viajesalkoste

# Google reviews (optional). Leave unset to use the curated reviews.
# Point this to a server endpoint that returns the Google Place Details
# "reviews" array, or a third-party Google-reviews feed (Featurable, Elfsight,
# Trustindex...). Only 4–5 star reviews are shown (rule in src/lib/googleReviews.js).
VITE_GOOGLE_REVIEWS_ENDPOINT=
VITE_GOOGLE_PLACE_ID=
VITE_GOOGLE_REVIEWS_URL=https://www.google.com/search?q=Viajes+Alkoste+Madrid+opiniones

# Flight search engine (motor de vuelos externo). Endpoint del bridge .aspx al
# que se envía el POST del buscador. Por defecto usa el de producción de Alkoste.
VITE_FLIGHT_BRIDGE_URL=http://vuelos.viajesalkoste.com/wtc/ak/vuelos/Default.aspx

# Contact form (no backend) — Web3Forms access key (https://web3forms.com).
# Create a free key (just needs your email) and paste it here. Without it,
# the contact form falls back to opening WhatsApp with the message pre-filled.
VITE_WEB3FORMS_KEY=
